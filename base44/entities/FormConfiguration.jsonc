{
  "type": "object",
  "properties": {
    "form_name": {
      "type": "string",
      "description": "Name of the form (e.g., 'Account Form', 'Entity Form')"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "Account",
        "Entity"
      ],
      "description": "Which entity this form configuration applies to"
    },
    "is_published": {
      "type": "boolean",
      "default": false,
      "description": "Whether this configuration is active for tenants"
    },
    "version": {
      "type": "string",
      "default": "1.0",
      "description": "Version number of this configuration"
    },
    "fields_config": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field_name": {
            "type": "string",
            "description": "Technical field name in the entity"
          },
          "display_label": {
            "type": "string",
            "description": "User-facing label"
          },
          "field_type": {
            "type": "string",
            "enum": [
              "text",
              "number",
              "date",
              "select",
              "boolean",
              "textarea",
              "email"
            ],
            "description": "Input type"
          },
          "is_visible": {
            "type": "boolean",
            "default": true,
            "description": "Whether field is shown in the form"
          },
          "is_required": {
            "type": "boolean",
            "default": false,
            "description": "Whether field is mandatory"
          },
          "is_custom": {
            "type": "boolean",
            "default": false,
            "description": "Whether this is a custom field (not in base schema)"
          },
          "order": {
            "type": "number",
            "description": "Display order in the form"
          },
          "section": {
            "type": "string",
            "description": "Which section/tab this field belongs to"
          },
          "placeholder": {
            "type": "string",
            "description": "Placeholder text"
          },
          "help_text": {
            "type": "string",
            "description": "Helper text below the field"
          },
          "referenced_data_key": {
            "type": "string",
            "description": "Key to lookup referenced data for select fields (format: EntityName.field_name)"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              }
            },
            "description": "Options for select fields"
          },
          "validation": {
            "type": "object",
            "properties": {
              "min": {
                "type": "number",
                "description": "Minimum value for numbers"
              },
              "max": {
                "type": "number",
                "description": "Maximum value for numbers"
              },
              "minLength": {
                "type": "number",
                "description": "Minimum length for text"
              },
              "maxLength": {
                "type": "number",
                "description": "Maximum length for text"
              },
              "pattern": {
                "type": "string",
                "description": "Regex pattern for validation"
              },
              "patternMessage": {
                "type": "string",
                "description": "Error message for pattern mismatch"
              }
            },
            "description": "Validation rules"
          },
          "conditional_visibility": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "description": "Field name to check"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "equals",
                  "not_equals",
                  "contains",
                  "greater_than",
                  "less_than",
                  "in",
                  "not_in"
                ],
                "description": "Comparison operator"
              },
              "value": {
                "type": "string",
                "description": "Value to compare against (comma-separated for 'in'/'not_in')"
              }
            },
            "description": "Condition for field visibility"
          },
          "conditional_required": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "description": "Field name to check"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "equals",
                  "not_equals",
                  "contains",
                  "greater_than",
                  "less_than",
                  "in",
                  "not_in"
                ],
                "description": "Comparison operator"
              },
              "value": {
                "type": "string",
                "description": "Value to compare against (comma-separated for 'in'/'not_in')"
              }
            },
            "description": "Condition for field being required"
          }
        }
      },
      "description": "Configuration for each form field"
    },
    "layout_config": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "number",
          "default": 2,
          "description": "Number of columns in the form grid"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "section_name": {
                "type": "string"
              },
              "section_label": {
                "type": "string"
              },
              "order": {
                "type": "number"
              },
              "collapsible": {
                "type": "boolean",
                "default": false
              }
            }
          },
          "description": "Section/tab definitions"
        }
      },
      "description": "Layout configuration for the form"
    },
    "published_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this configuration was published"
    },
    "published_by": {
      "type": "string",
      "description": "Email of super admin who published"
    }
  },
  "required": [
    "form_name",
    "entity_type",
    "fields_config"
  ],
  "name": "FormConfiguration"
}