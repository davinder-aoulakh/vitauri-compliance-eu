{
  "name": "ChangeCase",
  "type": "object",
  "description": "Classification Studio: change-in-circumstances case (HB para 202, 220).",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "changed_fields": {
      "items": {
        "properties": {
          "after": {
            "type": "string"
          },
          "before": {
            "type": "string"
          },
          "field": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "detected_at": {
      "format": "date-time",
      "type": "string"
    },
    "due_date": {
      "description": "Later of detected + 90 days or 31 Dec of the reporting period",
      "format": "date",
      "type": "string"
    },
    "proposed_decision_id": {
      "type": "string"
    },
    "resolution": {
      "type": "string"
    },
    "resolved_at": {
      "format": "date-time",
      "type": "string"
    },
    "resolved_by": {
      "type": "string"
    },
    "status": {
      "default": "open",
      "enum": [
        "open",
        "resolved",
        "overdue"
      ],
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "trigger": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "account_id",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "super_admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.app_role": "super_admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "super_admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "super_admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        }
      ]
    }
  }
}
