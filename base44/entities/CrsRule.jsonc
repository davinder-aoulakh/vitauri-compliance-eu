{
  "description": "CRS Rule Library: one rule inside a rule pack.",
  "properties": {
    "ai_guidance": {
      "type": "string"
    },
    "condition": {
      "description": "Condition-group JSON over the engine fact allowlist",
      "type": "object"
    },
    "crs_ref": {
      "type": "string"
    },
    "custom": {
      "default": false,
      "description": "Extra question added in the Rule Library (not a Handbook rule)",
      "type": "boolean"
    },
    "enabled": {
      "default": true,
      "type": "boolean"
    },
    "hb_ref": {
      "type": "string"
    },
    "help": {
      "type": "string"
    },
    "hook": {
      "description": "Extra questions only: where the question is asked",
      "enum": [
        "after_general",
        "individual",
        "entity"
      ],
      "type": "string"
    },
    "locked": {
      "default": false,
      "type": "boolean"
    },
    "options": {
      "items": {
        "properties": {
          "effect": {
            "description": "Extra questions only: continue or hold",
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "reason": {
            "description": "Extra questions only: shown when the option puts the account on hold",
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "order": {
      "type": "number"
    },
    "outcome_reason_template": {
      "type": "string"
    },
    "pack_id": {
      "type": "string"
    },
    "params": {
      "type": "object"
    },
    "procedure": {
      "enum": [
        "general",
        "individual_preexisting",
        "individual_new",
        "entity_preexisting",
        "entity_new",
        "controlling_persons",
        "trust",
        "joint",
        "change_in_circumstances",
        "custom"
      ],
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "rule_key": {
      "description": "Stable key, e.g. IND_PRE.HV_THRESHOLD",
      "type": "string"
    },
    "tier": {
      "enum": [
        "parameter",
        "text",
        "logic"
      ],
      "type": "string"
    }
  },
  "required": [
    "pack_id",
    "rule_key",
    "procedure",
    "tier"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "data.app_role": "super_admin"
      }
    },
    "delete": {
      "user_condition": {
        "data.app_role": "super_admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "data.app_role": "super_admin"
      }
    }
  },
  "name": "CrsRule"
}