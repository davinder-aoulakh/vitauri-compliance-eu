{
  "name": "Account",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Reference to the owning tenant"
    },
    "entity_id": {
      "type": "string",
      "description": "Reference to the RFI entity holding this account"
    },
    "account_number": {
      "type": "string",
      "description": "Unique account identifier"
    },
    "account_number_type": {
      "type": "string",
      "enum": [
        "IBAN",
        "Bank account number (non-IBAN)",
        "ISIN",
        "Securities account number (non-ISIN)",
        "Other account identifier",
        "No account number exists"
      ],
      "description": "Type of account number for CRS XML reporting. Maps to OECD601-OECD605 codes. 'No account number exists' results in NANUM being emitted with no type attribute."
    },
    "account_creation_date": {
      "type": "string",
      "format": "date",
      "description": "Date when the account was originally created"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "depository",
        "custodial",
        "equity_debt_interest",
        "cash_value_insurance",
        "annuity"
      ],
      "description": "Type of financial account"
    },
    "account_holder_entity_type": {
      "type": "string",
      "description": "Type of entity when account holder is an entity (e.g., corporation, trust, partnership)"
    },
    "account_holder_type": {
      "type": "string",
      "enum": [
        "individual",
        "entity"
      ],
      "description": "Whether account holder is individual or entity"
    },
    "account_holder_name": {
      "type": "string"
    },
    "first_name": {
      "type": "string",
      "description": "First name of individual account holder. If empty, 'NFN' is used in CRS XML."
    },
    "last_name": {
      "type": "string",
      "description": "Last name of individual account holder (mandatory for CRS XML)."
    },
    "middle_name": {
      "type": "string",
      "description": "Middle name(s) of individual account holder (optional, CRS XML MiddleName)."
    },
    "name_prefix": {
      "type": "string",
      "description": "Name prefix / title prefix (optional, CRS XML NamePrefix e.g. Mr, Mrs, Dr)."
    },
    "title": {
      "type": "string",
      "description": "Title of individual account holder (optional, CRS XML Title)."
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "For individual account holders"
    },
    "place_of_birth": {
      "type": "string",
      "description": "Country of birth - for individual account holders"
    },
    "date_of_incorporation": {
      "type": "string",
      "format": "date",
      "description": "Date of incorporation for entity account holders"
    },
    "country_of_incorporation": {
      "type": "string",
      "description": "Country where entity account holder is incorporated"
    },
    "country_of_incorporation_code": {
      "type": "string",
      "description": "ISO country code for country of incorporation"
    },
    "is_pre_existing": {
      "type": "boolean",
      "description": "Whether this account existed before December 31, 2018 (CRS pre-existing account threshold)"
    },
    "is_recalcitrant": {
      "type": "boolean",
      "default": false,
      "description": "Whether the individual account holder is recalcitrant. Mandatory for Individual AccountHolder in CRS XML (Section 6.3.2.3.2.1)."
    },
    "account_holder_is_alive": {
      "type": "boolean",
      "description": "For individual account holders - whether the account holder is alive"
    },
    "account_holder_deceased_during_period": {
      "type": "boolean",
      "description": "Whether account holder deceased during reporting period"
    },
    "death_certificate_requested": {
      "type": "boolean"
    },
    "death_certificate_requested_date": {
      "type": "string",
      "format": "date"
    },
    "death_certificate_received": {
      "type": "boolean"
    },
    "death_certificate_received_date": {
      "type": "string",
      "format": "date"
    },
    "will_or_inheritance_requested": {
      "type": "boolean"
    },
    "will_or_inheritance_requested_date": {
      "type": "string",
      "format": "date"
    },
    "will_or_inheritance_received": {
      "type": "boolean"
    },
    "will_or_inheritance_received_date": {
      "type": "string",
      "format": "date"
    },
    "legacy_of_deceased_settled": {
      "type": "boolean"
    },
    "legacy_settlement_date": {
      "type": "string",
      "format": "date"
    },
    "entity_managed_by_fiduciary_trust": {
      "type": "boolean"
    },
    "entity_managed_by_asset_manager": {
      "type": "boolean"
    },
    "gross_income_from_financial_assets": {
      "type": "boolean"
    },
    "gross_income_50_passive": {
      "type": "boolean",
      "description": "Whether 50% or more of the entity's gross income is passive income"
    },
    "non_reportable_exception_type": {
      "type": "string",
      "enum": [
        "inheritance_estate",
        "escrow_court_decree",
        "qualifying_pension",
        "overdraft_deposit",
        "pre_existing_dormant_below_1k",
        "publicly_traded",
        "purely_domestic",
        "international_organization",
        "liquidation_dissolution",
        "none"
      ],
      "description": "CRS S3-1 gate. When set to anything other than 'none' the account is immediately Non-Reportable \u2014 engine stops without running S4\u2013S6."
    },
    "potential_exception_type": {
      "type": "string",
      "enum": [
        "None",
        "DGA",
        "Foundation",
        "STAK",
        "HoldCo",
        "TreasuryCtr",
        "RealEstateFund"
      ],
      "description": "S4-1 routing. Routes account to exception sub-section 4A\u20134F. 'None' = run the main FI / A-NFE / P-NFE classification tree."
    },
    "treasury_activities_operational": {
      "type": "boolean",
      "description": "S4E criterion 1. Treasury activities are functional and operational (cash pooling, FX hedging, intercompany lending), not investment-driven."
    },
    "treasury_part_of_nonfinancial_group": {
      "type": "boolean",
      "description": "S4E criterion 2. Entity is part of a group primarily engaged in non-financial business (e.g. manufacturing, retail, services)."
    },
    "treasury_main_fn_finance_hedge_group": {
      "type": "boolean",
      "description": "S4E criterion 3. Main function is to finance or hedge transactions for operating companies within the same group."
    },
    "treasury_50pct_passive_income_fails": {
      "type": "boolean",
      "description": "S4E criterion 4. true = <50% of gross income is passive (passes). false = \u226550% passive (fails). NOTE: inverted vs the Excel column name."
    },
    "treasury_still_operational_despite_failing_50pct": {
      "type": "boolean",
      "description": "GAP 1 FIX. Only relevant when treasury_50pct_passive_income_fails is false (entity has \u226550% passive income). true = entity is still operationally active \u2192 A-NFE (Non-Reportable). false = genuinely non-operational \u2192 P-NFE (routes to Stage 2 Double Test)."
    },
    "account_closed_during_period": {
      "type": "boolean",
      "default": false
    },
    "account_frozen_at_reporting_date": {
      "type": "boolean",
      "description": "Whether the account was frozen at the reporting date"
    },
    "account_dormant_at_reporting_date": {
      "type": "boolean",
      "description": "Whether the account was dormant at the reporting date"
    },
    "acct_holder_address_unchanged": {
      "type": "boolean",
      "description": "Whether the account holder address is unchanged since last reporting period"
    },
    "type_of_financial_institution": {
      "type": "string",
      "enum": [
        "custodial_institution",
        "depository_institution",
        "investment_entity_type_a",
        "investment_entity_type_b",
        "specified_insurance_company"
      ],
      "description": "Standardized type of financial institution if account holder is an FI"
    },
    "crs_entity_classification": {
      "type": "string",
      "enum": [
        "CRS101",
        "CRS102",
        "CRS103"
      ],
      "description": "CRS classification for organisation account holders with non-US tax residencies. CRS101=Passive entity with controlling persons, CRS102=Active/financial entity that is itself a tax resident, CRS103=Passive entity that is itself also a tax resident."
    },
    "fatca_entity_classification": {
      "type": "string",
      "enum": [
        "FATCA101",
        "FATCA102",
        "FATCA103",
        "FATCA104",
        "FATCA105"
      ],
      "description": "FATCA classification for organisation account holders with US tax residency. FATCA101=Owner-Documented FI, FATCA102=Passive entity with substantial US owners, FATCA103=Non-participating FFI, FATCA104=Specified US Person, FATCA105=Direct Reporting NFFE."
    },
    "current_address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "account_holder_address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "country_of_residence": {
      "type": "string"
    },
    "current_email": {
      "type": "string",
      "format": "email"
    },
    "current_phone": {
      "type": "string"
    },
    "tax_residencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string"
          },
          "tin": {
            "type": "string"
          },
          "tin_unavailable_reason": {
            "type": "string"
          }
        }
      }
    },
    "entity_classification": {
      "type": "string",
      "enum": [
        "financial_institution",
        "active_nfe",
        "passive_nfe",
        "not_applicable"
      ]
    },
    "beneficiaries_count": {
      "type": "number",
      "default": 0,
      "description": "Number of beneficiaries linked to this account"
    },
    "controlling_persons_count": {
      "type": "number",
      "default": 0,
      "description": "Number of controlling persons linked to this account"
    },
    "has_unclassified_controlling_persons": {
      "type": "boolean",
      "default": false,
      "description": "Whether this account has controlling persons that are not yet classified"
    },
    "year_end_cash_value": {
      "type": "number"
    },
    "year_end_cash_value_currency": {
      "type": "string"
    },
    "gross_payments": {
      "type": "number"
    },
    "gross_payments_currency": {
      "type": "string"
    },
    "reporting_year": {
      "type": "string"
    },
    "reportability_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "reportable",
        "non_reportable",
        "excluded"
      ],
      "default": "pending_review"
    },
    "reportability_reason": {
      "type": "string"
    },
    "indicia_found": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "us_person_indic": {
      "type": "boolean",
      "description": "Indicates US status per FATCA"
    },
    "indicia_details": {
      "type": "object",
      "properties": {
        "citizenship": {
          "type": "string"
        },
        "us_address": {
          "type": "boolean"
        },
        "us_phone": {
          "type": "boolean"
        },
        "power_of_attorney": {
          "type": "boolean"
        },
        "standing_instructions": {
          "type": "boolean"
        }
      },
      "description": "Detailed US indicia: citizenship, address, phone, POA"
    },
    "multiple_residencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "One or more CRS country codes for tax residencies"
    },
    "self_certification_obtained": {
      "type": "boolean",
      "default": false
    },
    "self_certification_date": {
      "type": "string",
      "format": "date"
    },
    "self_certification_request_date": {
      "type": "string",
      "format": "date",
      "description": "Date when a new self-certification was requested"
    },
    "self_certification_overdue": {
      "type": "boolean",
      "default": false,
      "description": "True if 90 days have passed since self_certification_request_date and no new self-certification received"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "document_url": {
            "type": "string"
          },
          "document_name": {
            "type": "string"
          },
          "document_type": {
            "type": "string",
            "enum": [
              "self_certification",
              "supporting_document",
              "other"
            ]
          },
          "upload_date": {
            "type": "string",
            "format": "date-time"
          },
          "uploaded_by_email": {
            "type": "string"
          },
          "uploaded_by_name": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "classification_answers": {
      "type": "object"
    },
    "needs_reclassification": {
      "type": "boolean"
    },
    "compliance_issues_resolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compliance_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "resolved_date": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "additional_items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "item_name": {
            "type": "string",
            "maxLength": 200,
            "description": "Name/key of the additional item (max 200 chars)"
          },
          "item_content": {
            "type": "string",
            "maxLength": 4000,
            "description": "Content value of the additional item (max 4000 chars)"
          }
        },
        "required": [
          "item_name",
          "item_content"
        ]
      },
      "description": "Optional additional items for AccountReport (up to 100 items per spec)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed",
        "dormant"
      ],
      "default": "active"
    }
  },
  "required": [
    "tenant_id",
    "entity_id",
    "account_number",
    "account_creation_date",
    "account_holder_type",
    "current_email",
    "current_phone"
  ]
}