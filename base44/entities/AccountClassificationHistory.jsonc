{
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Reference to the owning tenant"
    },
    "account_id": {
      "type": "string",
      "description": "Reference to the account being classified"
    },
    "classification_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this classification was performed"
    },
    "reportability_status": {
      "type": "string",
      "enum": [
        "reportable",
        "non_reportable",
        "pending_review",
        "excluded",
        "work_in_progress"
      ],
      "description": "The reportability determination"
    },
    "previous_reportability_status": {
      "type": "string",
      "enum": [
        "reportable",
        "non_reportable",
        "pending_review",
        "excluded",
        "work_in_progress"
      ],
      "description": "Status this entry had before the controlling person roll-up updated it (e.g. work_in_progress)"
    },
    "classification_reason": {
      "type": "string",
      "description": "Detailed reason for this classification"
    },
    "cp_rollup_reason": {
      "type": "string",
      "description": "New reason added when controlling person classification completed and the account status was rolled up"
    },
    "cp_rollup_status": {
      "type": "string",
      "description": "Resulting account status after the controlling person roll-up"
    },
    "cp_rollup_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the controlling person roll-up was applied"
    },
    "classification_source": {
      "type": "string",
      "enum": [
        "workflow",
        "auto_classification",
        "manual"
      ],
      "default": "workflow",
      "description": "How this classification was performed"
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "classification",
        "workflow_transition"
      ],
      "default": "classification",
      "description": "workflow_transition = audit event recording a hand-off from one workflow to another"
    },
    "workflow_name": {
      "type": "string",
      "description": "Name of the workflow that produced this entry"
    },
    "transition_sequence": {
      "type": "number",
      "description": "Order of this transition within the classification session (1-based)"
    },
    "from_workflow_id": {
      "type": "string"
    },
    "from_workflow_name": {
      "type": "string"
    },
    "to_workflow_id": {
      "type": "string"
    },
    "to_workflow_name": {
      "type": "string"
    },
    "transition_step_id": {
      "type": "string"
    },
    "transition_step_title": {
      "type": "string"
    },
    "transition_mode": {
      "type": "string",
      "enum": [
        "direct",
        "conditional"
      ]
    },
    "transition_chain": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered workflow names involved in this classification session (final entries only)"
    },
    "rule_id": {
      "type": "string",
      "description": "Reference to the AutoClassificationRule that triggered this classification"
    },
    "rule_name": {
      "type": "string",
      "description": "Name of the rule at time of classification (for audit trail)"
    },
    "workflow_id": {
      "type": "string",
      "description": "Reference to the Workflow simulated during auto-classification"
    },
    "workflow_path_taken": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of step IDs visited during headless workflow simulation"
    },
    "reportable_jurisdictions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of jurisdictions where account is reportable"
    },
    "workflow_answers": {
      "type": "object",
      "description": "Complete workflow answers for audit trail (resolved from account fields)"
    },
    "indicia_found": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Foreign indicia identified during classification"
    },
    "self_certification_status": {
      "type": "string",
      "enum": [
        "obtained",
        "not_obtained",
        "not_required"
      ],
      "description": "Self-certification status at time of classification"
    },
    "performed_by": {
      "type": "string",
      "description": "Email of user who performed classification"
    },
    "account_holder_name": {
      "type": "string",
      "description": "Account holder name at time of classification"
    },
    "account_number": {
      "type": "string",
      "description": "Account number at time of classification"
    },
    "account_balance": {
      "type": "number",
      "description": "Account balance at time of classification"
    }
  },
  "required": [
    "tenant_id",
    "account_id",
    "classification_date",
    "reportability_status",
    "classification_reason"
  ],
  "name": "AccountClassificationHistory",
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "super_admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "super_admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "super_admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "super_admin"
          }
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        }
      ]
    }
  }
}