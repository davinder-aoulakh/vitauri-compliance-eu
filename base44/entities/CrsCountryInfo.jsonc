{
  "name": "CrsCountryInfo",
  "properties": {
    "country_code": {
      "description": "ISO country code (e.g., US, GB)",
      "type": "string"
    },
    "country_name": {
      "description": "Full country name",
      "type": "string"
    },
    "crs_implementation_date": {
      "description": "Date when CRS was implemented in this country",
      "format": "date",
      "type": "string"
    },
    "crs_reporting_details": {
      "description": "Additional CRS-specific information for this country",
      "type": "string"
    },
    "is_crs_country": {
      "default": false,
      "description": "Whether this country participates in CRS reporting",
      "type": "boolean"
    },
    "tin_issued_to_all": {
      "description": "Classification Studio: true when this jurisdiction issues TINs to all tax residents (CRS FAQ II-8). A missing TIN is then a reason to doubt a self-certification. Optional; not used by manual classification.",
      "type": "boolean"
    }
  },
  "required": [
    "country_code",
    "country_name",
    "is_crs_country"
  ],
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "data.app_role": "super_admin"
      }
    },
    "update": {
      "user_condition": {
        "data.app_role": "super_admin"
      }
    },
    "delete": {
      "user_condition": {
        "data.app_role": "super_admin"
      }
    }
  }
}