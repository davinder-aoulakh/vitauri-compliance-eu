{
  "name": "CrsCountryInfo",
  "type": "object",
  "properties": {
    "country_code": {
      "type": "string",
      "description": "ISO country code (e.g., US, GB)"
    },
    "country_name": {
      "type": "string",
      "description": "Full country name"
    },
    "is_crs_country": {
      "type": "boolean",
      "default": false,
      "description": "Whether this country participates in CRS reporting"
    },
    "crs_implementation_date": {
      "type": "string",
      "format": "date",
      "description": "Date when CRS was implemented in this country"
    },
    "crs_reporting_details": {
      "type": "string",
      "description": "Additional CRS-specific information for this country"
    }
  },
  "required": [
    "country_code",
    "country_name",
    "is_crs_country"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "data.app_role": "super_admin"
      }
    },
    "update": {
      "user_condition": {
        "data.app_role": "super_admin"
      }
    },
    "delete": {
      "user_condition": {
        "data.app_role": "super_admin"
      }
    }
  }
}