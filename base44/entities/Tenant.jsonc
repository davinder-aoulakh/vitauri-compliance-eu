{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Legal name of the financial institution"
    },
    "short_name": {
      "type": "string",
      "description": "Display name for the tenant"
    },
    "jurisdiction": {
      "type": "string",
      "description": "Primary jurisdiction/country of operation"
    },
    "tax_id": {
      "type": "string",
      "description": "Tax identification number"
    },
    "contact_email": {
      "type": "string",
      "format": "email"
    },
    "contact_phone": {
      "type": "string"
    },
    "address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "branding": {
      "type": "object",
      "properties": {
        "logo_url": {
          "type": "string"
        },
        "primary_color": {
          "type": "string",
          "default": "#464feb"
        },
        "secondary_color": {
          "type": "string",
          "default": "#1e293b"
        },
        "font_family": {
          "type": "string",
          "default": "Inter"
        }
      }
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "trial"
      ],
      "default": "active"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "basic",
        "professional",
        "enterprise"
      ],
      "default": "professional"
    },
    "navigation_settings": {
      "type": "object",
      "description": "Navigation menu configuration",
      "properties": {
        "crs_menu_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Dashboard",
            "Activity Log",
            "RFI Entities",
            "Accounts",
            "CRS Reports",
            "AI Assistant"
          ],
          "description": "Order of CRS menu items"
        },
        "fatca_menu_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Dashboard",
            "Activity Log",
            "FFI Entities",
            "Accounts",
            "FATCA Reports"
          ],
          "description": "Order of FATCA menu items"
        },
        "crs_default_collapsed": {
          "type": "boolean",
          "default": false,
          "description": "Whether CRS section is collapsed by default"
        },
        "fatca_default_collapsed": {
          "type": "boolean",
          "default": false,
          "description": "Whether FATCA section is collapsed by default"
        },
        "administration_default_collapsed": {
          "type": "boolean",
          "default": false,
          "description": "Whether Administration section is collapsed by default"
        }
      }
    },
    "enabled_features": {
      "type": "object",
      "description": "Feature flags to control tenant access to specific platform capabilities",
      "properties": {
        "crs_enabled": {
          "type": "boolean",
          "default": true
        },
        "fatca_enabled": {
          "type": "boolean",
          "default": false
        },
        "ai_bulk_import": {
          "type": "boolean",
          "default": true
        },
        "ai_classification_assistant": {
          "type": "boolean",
          "default": true
        },
        "ai_data_validator": {
          "type": "boolean",
          "default": true
        },
        "ai_jurisdiction_advisor": {
          "type": "boolean",
          "default": true
        },
        "ai_help_assistant": {
          "type": "boolean",
          "default": true
        },
        "ai_workflow_helper": {
          "type": "boolean",
          "default": true
        },
        "ai_document_parser": {
          "type": "boolean",
          "default": true
        },
        "dashboard_builder": {
          "type": "boolean",
          "default": true
        },
        "guided_tours": {
          "type": "boolean",
          "default": true
        },
        "compliance_assistant": {
          "type": "boolean",
          "default": true
        },
        "advanced_reporting": {
          "type": "boolean",
          "default": true
        },
        "audit_logging": {
          "type": "boolean",
          "default": true
        },
        "user_management": {
          "type": "boolean",
          "default": true
        },
        "validation_rules": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "support_hub_sync_status": {
      "type": "string",
      "enum": [
        "pending",
        "synced",
        "failed",
        "retrying"
      ],
      "default": "pending",
      "description": "Synchronization status with the Support Hub application"
    }
  },
  "required": [
    "name",
    "jurisdiction"
  ],
  "name": "Tenant"
}