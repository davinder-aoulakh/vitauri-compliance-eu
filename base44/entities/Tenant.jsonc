{
  "properties": {
    "address": {
      "properties": {
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "street": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "branding": {
      "properties": {
        "font_family": {
          "default": "Inter",
          "type": "string"
        },
        "logo_url": {
          "type": "string"
        },
        "primary_color": {
          "default": "#464feb",
          "type": "string"
        },
        "secondary_color": {
          "default": "#1e293b",
          "type": "string"
        }
      },
      "type": "object"
    },
    "contact_email": {
      "format": "email",
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "default_mfa_enabled": {
      "default": true,
      "description": "Whether 2FA is enabled by default for all newly invited users in this tenant",
      "type": "boolean"
    },
    "enabled_features": {
      "description": "Feature flags to control tenant access to specific platform capabilities",
      "properties": {
        "advanced_reporting": {
          "default": true,
          "type": "boolean"
        },
        "ai_bulk_import": {
          "default": true,
          "type": "boolean"
        },
        "ai_classification_assistant": {
          "default": true,
          "type": "boolean"
        },
        "ai_data_validator": {
          "default": true,
          "type": "boolean"
        },
        "ai_document_parser": {
          "default": true,
          "type": "boolean"
        },
        "ai_help_assistant": {
          "default": true,
          "type": "boolean"
        },
        "ai_jurisdiction_advisor": {
          "default": true,
          "type": "boolean"
        },
        "ai_workflow_helper": {
          "default": true,
          "type": "boolean"
        },
        "audit_logging": {
          "default": true,
          "type": "boolean"
        },
        "compliance_assistant": {
          "default": true,
          "type": "boolean"
        },
        "compliance_support": {
          "default": false,
          "type": "boolean"
        },
        "crs_enabled": {
          "default": true,
          "type": "boolean"
        },
        "dashboard_builder": {
          "default": true,
          "type": "boolean"
        },
        "fatca_enabled": {
          "default": false,
          "type": "boolean"
        },
        "flowchart_view": {
          "default": false,
          "description": "Shows the workflow Flowchart action on Account, Entity, and Controlling Person classification screens",
          "type": "boolean"
        },
        "guided_tours": {
          "default": true,
          "type": "boolean"
        },
        "user_management": {
          "default": true,
          "type": "boolean"
        },
        "validation_rules": {
          "default": true,
          "type": "boolean"
        },
        "classification_studio": {
          "default": false,
          "description": "Classification Studio (pilot): data-first CRS classification with decision records",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "jurisdiction": {
      "description": "Primary jurisdiction/country of operation",
      "type": "string"
    },
    "name": {
      "description": "Legal name of the financial institution",
      "type": "string"
    },
    "navigation_settings": {
      "description": "Navigation menu configuration",
      "properties": {
        "administration_default_collapsed": {
          "default": false,
          "type": "boolean"
        },
        "crs_default_collapsed": {
          "default": false,
          "type": "boolean"
        },
        "crs_menu_order": {
          "default": [
            "Dashboard",
            "Activity Log",
            "RFI Entities",
            "Accounts",
            "CRS Reports",
            "AI Assistant"
          ],
          "description": "Order of CRS menu items",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "fatca_default_collapsed": {
          "default": false,
          "type": "boolean"
        },
        "fatca_menu_order": {
          "default": [
            "Dashboard",
            "Activity Log",
            "FFI Entities",
            "Accounts",
            "FATCA Reports"
          ],
          "description": "Order of FATCA menu items",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "preexisting_cutoff": {
      "description": "CRS pre-existing account cut-off date for this tenant (accounts open on or before it are pre-existing). Empty = 31 Dec 2017 (previous default).",
      "format": "date",
      "type": "string"
    },
    "short_name": {
      "description": "Display name for the tenant",
      "type": "string"
    },
    "subscription_status": {
      "default": "active",
      "enum": [
        "active",
        "suspended",
        "trial"
      ],
      "type": "string"
    },
    "subscription_tier": {
      "default": "professional",
      "enum": [
        "basic",
        "professional",
        "enterprise"
      ],
      "type": "string"
    },
    "support_hub_sync_status": {
      "default": "pending",
      "description": "Synchronization status with the Support Hub application",
      "enum": [
        "pending",
        "synced",
        "failed",
        "retrying"
      ],
      "type": "string"
    },
    "tax_id": {
      "description": "Tax identification number",
      "type": "string"
    }
  },
  "required": [
    "name",
    "jurisdiction"
  ],
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "super_admin"
          }
        },
        {
          "id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "super_admin"
          }
        },
        {
          "id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "data.app_role": "super_admin"
      }
    },
    "delete": {
      "user_condition": {
        "data.app_role": "super_admin"
      }
    }
  },
  "name": "Tenant"
}